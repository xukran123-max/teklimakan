<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. /seidiye ئادرېسىنى seidiye.html غا ئۇلاش
  RewriteRule ^seidiye/?$ seidiye.html [L,QSA]

  # 2. كونا admin ئادرېسىنى باش بەتكە قايتۇرۇش
  RewriteRule ^admin(\.html)?$ / [R=301,L]

  # 3. Clean URLs
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>
