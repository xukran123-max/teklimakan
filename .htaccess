<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. /seidiye ئادرېسىنى seidiye.html غا ئۇلاش
  RewriteRule ^seidiye/?$ seidiye.html [L,QSA]

  # 2. كونا admin ئادرېسىنى باش بەتكە قايتۇرۇش
  RewriteRule ^admin(\.html)?$ / [R=301,L]

  # 3. Clean URLs
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # 4. ئىجتىمائىي تاراتقۇ بوتلىرى (WhatsApp, Facebook, Telegram) /tr ۋە /en ئۈچۈن OG meta بار ئايرىم بەتنى كۆرسۈن
  RewriteCond %{HTTP_USER_AGENT} (WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|Pinterestbot) [NC]
  RewriteRule ^tr/?$ tr/index.html [L,QSA]

  RewriteCond %{HTTP_USER_AGENT} (WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|Pinterestbot) [NC]
  RewriteRule ^en/?$ en/index.html [L,QSA]

  # 5. تىل قىسقا ئادرېسلىرى (/tr, /en, /ug) - ئادەتتىكى زىيارەتچىلەر ئۈچۈن بىۋاسىتە index.html كۆرسىتىش (Internal Rewrite)
  RewriteRule ^tr/?$ index.html [L,QSA]
  RewriteRule ^tr\.html$ index.html [L,QSA]
  RewriteRule ^en/?$ index.html [L,QSA]
  RewriteRule ^en\.html$ index.html [L,QSA]
  RewriteRule ^ug/?$ index.html [L,QSA]
</IfModule>
