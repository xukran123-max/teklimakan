{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(google0665b7e663873c46(?:\\.html)?)",
      "destination": "/api/google-verify"
    },
    {
      "source": "/(google[a-zA-Z0-9_-]+\\.html)",
      "destination": "/api/google-verify"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/product-preview/(.*)",
      "destination": "/api/product-image?id=$1"
    },
    {
      "source": "/p/(.*)",
      "destination": "/api/product-share?slug=$1"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "id"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|Pinterestbot).*"
        }
      ],
      "destination": "/api/product-share"
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "query",
          "key": "id"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|Pinterestbot).*"
        }
      ],
      "destination": "/api/product-share"
    },
    {
      "source": "/ug",
      "destination": "/index.html"
    },
    {
      "source": "/ug/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/seidiye",
      "destination": "/seidiye.html"
    },
    {
      "source": "/seidiye/(.*)",
      "destination": "/seidiye.html"
    }
  ],
  "redirects": [
    {
      "source": "/tr",
      "destination": "https://teklimakan.online",
      "permanent": false
    },
    {
      "source": "/tr/(.*)",
      "destination": "https://teklimakan.online",
      "permanent": false
    },
    {
      "source": "/tr.html",
      "destination": "https://teklimakan.online",
      "permanent": false
    },
    {
      "source": "/en",
      "destination": "https://teklimakan.online",
      "permanent": false
    },
    {
      "source": "/en/(.*)",
      "destination": "https://teklimakan.online",
      "permanent": false
    },
    {
      "source": "/en.html",
      "destination": "https://teklimakan.online",
      "permanent": false
    },
    {
      "source": "/admin.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/admin",
      "destination": "/",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/daily-broadcast",
      "schedule": "30 17 * * *"
    }
  ]
}