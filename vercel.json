{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "id"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|Pinterestbot).*"
        }
      ],
      "destination": "/api/product-share"
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "query",
          "key": "id"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|Pinterestbot).*"
        }
      ],
      "destination": "/api/product-share"
    },
    {
      "source": "/tr",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|Pinterestbot).*"
        }
      ],
      "destination": "/tr/index.html"
    },
    {
      "source": "/en",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|Pinterestbot).*"
        }
      ],
      "destination": "/en/index.html"
    },
    {
      "source": "/tr",
      "destination": "/index.html"
    },
    {
      "source": "/tr/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/tr.html",
      "destination": "/index.html"
    },
    {
      "source": "/en",
      "destination": "/index.html"
    },
    {
      "source": "/en/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/en.html",
      "destination": "/index.html"
    },
    {
      "source": "/ug",
      "destination": "/index.html"
    },
    {
      "source": "/ug/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/seidiye",
      "destination": "/seidiye.html"
    },
    {
      "source": "/seidiye/(.*)",
      "destination": "/seidiye.html"
    }
  ],
  "redirects": [
    {
      "source": "/admin.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/admin",
      "destination": "/",
      "permanent": false
    }
  ]
}
