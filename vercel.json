{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "id"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot).*"
        }
      ],
      "destination": "/api/product-share"
    },
    {
      "source": "/seidiye",
      "destination": "/seidiye.html"
    },
    {
      "source": "/seidiye/(.*)",
      "destination": "/seidiye.html"
    }
  ],
  "redirects": [
    {
      "source": "/admin.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/admin",
      "destination": "/",
      "permanent": false
    }
  ]
}
